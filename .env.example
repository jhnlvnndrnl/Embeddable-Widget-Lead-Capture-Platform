# Application Settings
APP_NAME="Embeddable Widget & Lead-Capture Platform"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Database Configuration
DATABASE_URL="sqlite:///./widget_platform.db"

# Base URL (for generating embed script URLs)
BASE_URL="http://localhost:8000"

# Rate Limiting (max submissions per minute per IP/widget)
RATE_LIMIT_PER_MINUTE=5

# Maximum allowed submission payload size in bytes (e.g. 64KB = 65536)
MAX_PAYLOAD_SIZE_BYTES=65536

# Geo Fallback Providers & Mock Toggles for Testing
# Set to true to simulate provider failure
MOCK_GEO_PROVIDER_A_DOWN=false
MOCK_GEO_PROVIDER_B_DOWN=false

# Webhook / Notification simulation
MOCK_EMAIL_SHOULD_FAIL=false
